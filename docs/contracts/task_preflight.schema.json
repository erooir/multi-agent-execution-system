{
  "$defs": {
    "ProjectKnowledgeScope": {
      "additionalProperties": false,
      "properties": {
        "eligible": {
          "description": "项目中对当前任务可用的公开资料数",
          "minimum": 0,
          "title": "Eligible",
          "type": "integer"
        },
        "matched": {
          "description": "手动选择和检索命中的来源数",
          "minimum": 0,
          "title": "Matched",
          "type": "integer"
        },
        "selected": {
          "description": "本次实际选入的资料数",
          "minimum": 0,
          "title": "Selected",
          "type": "integer"
        }
      },
      "required": [
        "eligible",
        "matched",
        "selected"
      ],
      "title": "ProjectKnowledgeScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ready": {
      "title": "Ready",
      "type": "boolean"
    },
    "existing_task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Existing Task Id"
    },
    "selected_agents": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Selected Agents",
      "type": "array"
    },
    "checks": {
      "items": {
        "type": "string"
      },
      "title": "Checks",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "knowledge_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectKnowledgeScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "ready"
  ],
  "title": "TaskPreflight",
  "type": "object"
}
