{
  "$defs": {
    "ExecutorBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "implementation": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "implementation"
      ],
      "title": "ExecutorBinding",
      "type": "object"
    },
    "Member": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "version"
      ],
      "title": "Member",
      "type": "object"
    },
    "SkillReference": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "skill_id"
      ],
      "title": "SkillReference",
      "type": "object"
    },
    "ToolReference": {
      "additionalProperties": false,
      "properties": {
        "tool_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Tool Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "tool_id"
      ],
      "title": "ToolReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 2000,
      "title": "Description",
      "type": "string"
    },
    "purpose": {
      "default": "general",
      "enum": [
        "general",
        "specialized"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "structure": {
      "default": "atomic",
      "enum": [
        "atomic",
        "composite"
      ],
      "title": "Structure",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "enum": [
          "structured_transform",
          "source_summary",
          "text_analysis",
          "image_inspect",
          "image_ocr",
          "image_understand",
          "audio_transcribe",
          "video_analyze",
          "case_analysis",
          "autonomous_analysis"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "modalities": {
      "items": {
        "enum": [
          "text",
          "structured",
          "image",
          "audio",
          "video"
        ],
        "type": "string"
      },
      "title": "Modalities",
      "type": "array"
    },
    "tool_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Tool Ids",
      "type": "array"
    },
    "instructions": {
      "default": "",
      "maxLength": 8000,
      "title": "Instructions",
      "type": "string"
    },
    "model_policy": {
      "default": "local",
      "enum": [
        "local",
        "cloud"
      ],
      "title": "Model Policy",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/Member"
      },
      "maxItems": 20,
      "title": "Members",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "execution_strategy": {
      "default": "fixed",
      "enum": [
        "fixed",
        "tool_agent"
      ],
      "title": "Execution Strategy",
      "type": "string"
    },
    "tool_refs": {
      "items": {
        "$ref": "#/$defs/ToolReference"
      },
      "maxItems": 48,
      "title": "Tool Refs",
      "type": "array"
    },
    "skill_refs": {
      "items": {
        "$ref": "#/$defs/SkillReference"
      },
      "maxItems": 12,
      "title": "Skill Refs",
      "type": "array"
    },
    "executor_bindings": {
      "additionalProperties": {
        "$ref": "#/$defs/ExecutorBinding"
      },
      "propertyNames": {
        "enum": [
          "local",
          "cloud"
        ]
      },
      "title": "Executor Bindings",
      "type": "object"
    }
  },
  "required": [
    "project_id",
    "name",
    "capabilities"
  ],
  "title": "AgentInput",
  "type": "object"
}
