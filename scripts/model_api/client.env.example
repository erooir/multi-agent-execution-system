# Set these variables in the existing local application's API and Worker environment.
# The SSH tunnel must be active. Supply the key securely; do not commit it.
HANGZHI_UPSTREAM_MODEL_URL=http://127.0.0.1:8001/v1
HANGZHI_UPSTREAM_MODEL_ID=hangzhi-qwen38
HANGZHI_UPSTREAM_BILLING=internal_zero
HANGZHI_UPSTREAM_API_KEY=replace-with-dedicated-secret
HANGZHI_UPSTREAM_TIMEOUT_SECONDS=180
HANGZHI_UPSTREAM_MAX_OUTPUT_TOKENS=16000
# 0 removes the per-task request-count cap; task deadline/cancellation still apply.
HANGZHI_UPSTREAM_MAX_TASK_REQUESTS=60
HANGZHI_UPSTREAM_TEMPERATURE=0
HANGZHI_UPSTREAM_TOP_P=1
HANGZHI_UPSTREAM_ENABLE_THINKING=false
HANGZHI_CONTEXT_TOKENS=32768
HANGZHI_MODEL_SLOTS=2
# Current application policy must allow HTTP model calls, including intranet.
HANGZHI_OFFLINE=false
